# Canonical AI virtual host for the shared host-level Caddy on R3.
#
# Merge this site block into /etc/caddy/Caddyfile alongside the Jenkins site.
# The AI Compose project must never publish ports 80/443 itself.
ai.solaris.io.vn {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	# Metrics contain process/runtime details and are reachable only from the
	# platform WireGuard peer. Prometheus keeps this hostname for TLS/SNI while
	# resolving it to the AI WireGuard address.
	@metrics path /metrics /metrics/*
	handle @metrics {
		@platform remote_ip 10.20.0.1
		handle @platform {
			reverse_proxy 127.0.0.1:18000
		}
		respond "Forbidden" 403
	}

	# gRPC and REST intentionally share the same public origin. The raw h2c and
	# FastAPI listeners are loopback-only and cannot be reached from the network.
	handle {
		@grpc protocol grpc
		reverse_proxy @grpc h2c://127.0.0.1:15051
		reverse_proxy 127.0.0.1:18000
	}

	log {
		output stdout
		format json
	}
}
