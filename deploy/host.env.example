# Non-secret settings provisioned once at /opt/solar-ai/config/host.env.
AI_PUBLIC_DOMAIN=ai.solars.io.vn
AI_DNS_ZONE=solars.io.vn
AI_PUBLIC_IPV4=116.118.6.30
AI_OBSERVABILITY_MODE=standalone
AI_SECRETS_FILE=/opt/solar-ai/secrets/ai.env

# Standalone is the safe default and deploys only the AI application on R3.
# When the central observability VPS is available, change the mode to central,
# then configure the values below. The deploy scripts enable the matching
# Compose profile automatically only in central mode.
# AI_MONITORING_BIND_IP=10.20.0.2
# PLATFORM_WIREGUARD_IPV4=10.20.0.1
# AI_DOCKER_SOCKET_GID=988  # Must equal: stat -c '%g' /var/run/docker.sock
# LOKI_PUSH_URL=http://10.20.0.1:3100/loki/api/v1/push
