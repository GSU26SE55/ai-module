# AI Module — safe example only. Never commit real credentials.

APP_ENV=development
LOG_LEVEL=INFO

# Hybrid server: one Python process serves HTTP and gRPC with shared model/state.
AI_ENABLE_GRPC=true
GRPC_BIND_HOST=0.0.0.0
GRPC_PORT=50051

# Production readiness requirements.
AI_VERIFY_MODEL_MANIFEST=true
AI_REQUIRE_LFP=true
AI_PRELOAD_RAG=true
AI_REQUIRE_RAG=true
AI_TORCH_COMPILE=false

# Production container paths. Local development may omit these.
AI_DATA_DIR=/data
AI_KB_DIR=/data/kb/current
AI_PRESCRIPTION_HISTORY_DIR=/data/prescription-history
AI_CLASSIFICATION_FEEDBACK_DIR=/data/classification-feedback
AI_EMBEDDING_MODEL_PATH=/opt/embedding-model

# Disable runtime downloads; the Docker build embeds the exact model revision.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/opt/huggingface
ANONYMIZED_TELEMETRY=false
TOKENIZERS_PARALLELISM=false

# LLM provider chain used only by enriched prescriptions.
LLM_PROVIDER_CHAIN=deepseek,gemini
LLM_HOURLY_BUDGET=60
SAFETY_LLM_JUDGE=0

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
