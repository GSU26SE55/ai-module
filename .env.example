# AI Module — Environment Variables
# Copy this file to .env and fill in values
# .env is gitignored — never commit real keys

# LLM provider chain for /prescribe?enrich=true (GH-79) — DeepSeek primary, Gemini backup.
# is_available() = true if at least one key below is set.
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# Anthropic kept as optional backward-compat tier — not in the default chain.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Comma-separated provider order tried by src/services/llm/chain.py.
# LLM_PROVIDER_CHAIN=deepseek,gemini

# Optional: override model version
# MODEL_VERSION=1.3
