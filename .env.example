# AI Module — Environment Variables
# Copy this file to .env and fill in values
# .env is gitignored — never commit real keys
#
# Load:
#   - Docker:    env_file: .env in docker-compose
#   - Local dev: uvicorn main:app --env-file .env   (or export vars manually)
#   - Scripts:   PowerShell: $env:DEEPSEEK_API_KEY="sk-..."; python scripts/eval_query_gen.py

# ── LLM provider chain (GH-79) — /prescribe?enrich=true ─────────────────
# DeepSeek primary, Gemini backup. is_available() = true if at least one key is set.
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# Anthropic kept as optional backward-compat tier — not in the default chain.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Comma-separated provider order tried by src/services/prescription/llm/chain.py.
# LLM_PROVIDER_CHAIN=deepseek,gemini

# ── Safety gate v2 (GH-81) ───────────────────────────────────────────────
# LLM-as-judge on enriched output — default OFF (extra LLM call per enrich
# request); rule-based output validation always runs regardless.
# SAFETY_LLM_JUDGE=0

# ── gRPC serving (GH-39→42) ──────────────────────────────────────────────
# Internal docker network only — do NOT expose 50051 publicly.
# GRPC_PORT=50051
# GRPC_HOST=localhost   # client-side only (scripts/grpc_client_demo.py)
